# Environment Variables
# Copy this file to .env and fill in the values.
# Never commit the .env file to version control.

# ─── Application ────────────────────────────────────────────────────────────────
# Requires Node.js >= 24 (see engines in package.json / .nvmrc)
NODE_ENV=development
# Local default 3001. On Render, leave PORT unset: Render injects it (default 10000).
PORT=3001

# ─── Database ────────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://campusflow:campusflow_dev@localhost:5432/campusflow?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────────
# Format: redis://[:password@]host[:port][/db-number]
# Use rediss:// for TLS (TLS is enabled automatically for rediss URLs).
# BullMQ requires the server's maxmemory-policy to be `noeviction`.
REDIS_URL=redis://localhost:6379

# ─── Authentication ──────────────────────────────────────────────────────────────
# Both must be at least 64 characters (Joi validation). Generate each with:
#   openssl rand -hex 64
# Render's `generateValue: true` produces only 44 chars — do not use it for these.
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MINIMUM_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET_MINIMUM_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Fares ───────────────────────────────────────────────────────────────────────
FARE_BASE_FARE=50
FARE_PER_KM_RATE=12

# ─── Matching Engine ─────────────────────────────────────────────────────────────
MATCHING_RADIUS_KM=5
MATCHING_MAX_CANDIDATES=20
MATCHING_TOP_N=3
MATCHING_ACCEPTANCE_WINDOW_MS=15000
MATCHING_MAX_RETRY_COUNT=0
MATCHING_WEIGHT_DISTANCE=0.50
MATCHING_WEIGHT_RATING=0.30
MATCHING_WEIGHT_ACCEPTANCE=0.20

# ─── Monitoring ──────────────────────────────────────────────────────────────────
# Optional. Leave commented out to disable Sentry (an empty value fails validation).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ─── Throttling ──────────────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# ─── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash),
# e.g. https://campusflow-six-chi.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
